              }
            },
            {
              "id": "auto",
              "title": {
                "en": "Auto",
                "es": "Auto"
              }
            },
            {
              "id": "cool",
              "title": {
                "en": "Cool",
                "es": "Frío"
              }
            },
            {
              "id": "heat",
              "title": {
                "en": "Heat",
                "es": "Calor"
              }
            },
            {
              "id": "dry",
              "title": {
                "en": "Dry",
                "es": "Secado"
              }
            },
            {
              "id": "fan",
              "title": {
                "en": "Fan",
                "es": "Ventilador"
              }
            }
          ]
        },
        "button.reload_codes": {
          "maintenanceAction": true,
          "title": {
            "en": "Reload codes",
            "es": "Recargar códigos"
          },
          "desc": {
            "en": "Reload this device's command codes from the code sheet.",
            "es": "Vuelve a cargar los códigos de comandos de este equipo desde la planilla."
          }
        },
        "button.reconnect": {
          "maintenanceAction": true,
          "title": {
            "en": "Reconnect control",
            "es": "Reconectar control"
          },
          "desc": {
            "en": "Try to reconnect the IR control if it stopped responding.",
            "es": "Intenta reconectar el control IR si dejó de responder."
          }
        }
      },
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Connection",
            "es": "Conexión"
          },
          "children": [
            {
              "id": "phm_host_info",
              "type": "label",
              "label": {
                "en": "IP Pantea Home Manager",
                "es": "IP Pantea Home Manager"
              },
              "hint": {
                "en": "This value is changed from the app settings (More → Apps → Pantea Smart Devices → Configure), and applies to every unit.",
                "es": "Este dato se modifica desde la configuración de la app (Más → Apps → Pantea Smart Devices → Configurar) y aplica a todos los equipos."
              },
              "value": ""
            },
            {
              "id": "remote_entity",
              "type": "text",
              "label": {
                "en": "Remote entity",
                "es": "Entidad remote"
              },
              "hint": {
                "en": "Name of the IR remote in Pantea Home Manager, always lowercase (without the 'remote.' prefix).",
                "es": "Nombre del control IR en Pantea Home Manager, SIEMPRE en minúsculas (sin el prefijo 'remote.')."
              },
              "value": ""
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Equipment",
            "es": "Equipo"
          },
          "children": [
            {
              "id": "code",
              "type": "text",
              "label": {
                "en": "Code (code sheet)",
                "es": "Code (planilla de códigos)"
              },
              "hint": {
                "en": "Numeric code from the code sheet. Leave empty to let the server resolve commands with what this remote has learned.",
                "es": "Code numérico de la planilla de códigos. Dejar vacío para que el servidor resuelva los comandos con lo aprendido por este control."
              },
              "value": ""
            },
            {
              "id": "temp_source",
              "type": "text",
              "label": {
                "en": "Temperature source device",
                "es": "Dispositivo fuente de temperatura"
              },
              "hint": {
                "en": "Name of the device whose temperature is shown on this tile. Empty: no temperature is shown.",
                "es": "Nombre del dispositivo cuya temperatura se muestra en este tile. Vacío: no se muestra temperatura."
              },
              "value": ""
            },
            {
              "id": "auto_on",
              "type": "checkbox",
              "label": {
                "en": "Turn on when temperature changes",
                "es": "Encender al cambiar temperatura"
              },
              "hint": {
                "en": "If the unit is off and the temperature is changed, turn it on in the last used mode.",
                "es": "Si el equipo está apagado y se cambia la temperatura, se enciende en el último modo utilizado."
              },
              "value": true
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Unit features",
            "es": "Funciones del equipo"
          },
          "children": [
            {
              "id": "allow_heat",
              "type": "checkbox",
              "label": {
                "en": "Has Heat mode?",
                "es": "Tiene modo Heat?"
              },
              "value": true
            },
            {
              "id": "allow_dry",
              "type": "checkbox",
              "label": {
                "en": "Has Dry mode?",
                "es": "Tiene modo Dry?"
              },
              "value": false
            },
            {
              "id": "allow_fan_mode",
              "type": "checkbox",
              "label": {
                "en": "Has Fan mode?",
                "es": "Tiene modo Fan?"
              },
              "value": false
            },
            {
              "id": "swing_type",
              "type": "dropdown",
              "label": {
                "en": "Swing",
                "es": "Swing"
              },
              "hint": {
                "en": "On/off: a simple toggle. Positions: pick moving or a fixed position from a list. Disabled: no swing control on the tile.",
                "es": "On/off: un botón simple. Por posición: elegir de una lista entre moviéndose o una posición fija. Desactivado: sin control de swing en el tile."
              },
              "value": "onoff",
              "values": [
                {
                  "id": "onoff",
                  "label": {
                    "en": "On/off",
                    "es": "On/off"
                  }
                },
                {
                  "id": "positions",
                  "label": {
                    "en": "Positions",
                    "es": "Por posición"
                  }
                },
                {
                  "id": "none",
                  "label": {
                    "en": "Disabled",
                    "es": "Desactivado"
                  }
                }
              ]
            },
            {
              "id": "allow_sleep",
              "type": "checkbox",
              "label": {
                "en": "Has Sleep option?",
                "es": "Tiene opción Sleep?"
              },
              "hint": {
                "en": "If disabled, the sleep control is hidden and 'off' is always sent.",
                "es": "Si se desactiva, se oculta el control de sleep y se envía siempre 'off'."
              },
              "value": false
            },
            {
              "id": "allow_fan_speed",
              "type": "checkbox",
              "label": {
                "en": "Allow choosing fan speed?",
                "es": "Permitir elegir Velocidad?"
              },
              "hint": {
                "en": "If disabled, fan stays 'auto' in every mode.",
                "es": "Si no está activado queda Ventilador = auto en todos los modos."
              },
              "value": false
            },
            {
              "id": "auto_off_mode",
              "type": "dropdown",
              "label": {
                "en": "Auto-off",
                "es": "Apagado automático"
              },
              "hint": {
                "en": "Adds a slider to the tile to turn the unit off after a while. Managed by Pantea: nothing is sent now — the off command goes out when the time is up, so the unit will most likely beep hours later. Managed by the unit: the timer is sent to it now over IR, it beeps right away and turns itself off; it needs the auto-off codes learned (like swing), and any later command sent to the unit clears its timer.",
                "es": "Agrega al tile un control para apagar el equipo dentro de un rato. Lo maneja Pantea: ahora no se manda nada — la orden de apagado sale al cumplirse el tiempo, así que es muy probable que el equipo haga el beep de apagado recién en x hs. Lo maneja el aire: el temporizador se le envía ahora por IR, hace el beep en el momento y se apaga solo; necesita los códigos de apagado automático aprendidos (igual que el swing), y cualquier comando posterior que se le envíe le borra el temporizador."
              },
              "value": "none",
              "values": [
                {
                  "id": "none",
                  "label": {
                    "en": "Disabled",
                    "es": "Desactivado"
                  }
                },
                {
                  "id": "device",
                  "label": {
                    "en": "Managed by Pantea",
                    "es": "Lo maneja Pantea"
                  }
                },
                {
                  "id": "ir",
                  "label": {
                    "en": "Managed by the unit (IR)",
                    "es": "Lo maneja el aire (IR)"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Real state of the unit",
